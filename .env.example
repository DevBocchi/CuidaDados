# Copie para .env e preencha. NUNCA versione o .env.

# Segredo que assina os tokens de acesso (Parte 2). Use um valor longo e aleatório.
APP_SECRET=

# Rotas /demo/* (somente para demonstração/testes). Em produção deixe 0.
MODO_DEMO=0

# Auditoria (Parte 2): banco SQLite e, opcionalmente, arquivo com as linhas JSON.
AUDIT_DB=data/auditoria.db
AUDIT_LOG_FILE=

# IA (Parte 3). Sem estas variáveis o sistema usa mensagens de reserva (funciona igual).
# LLM_PROVIDER: openai ou gemini. LLM_MODEL: nome do modelo da SUA conta (confira na documentação).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=8
